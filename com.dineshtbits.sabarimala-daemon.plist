<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd LaunchAgent for continuous_monitor.py, run through run_daemon.sh
  so every (re)start pulls the latest code first (see run_daemon.sh).

  BEFORE installing, edit the two /Users/CHANGEME/... paths below to match
  wherever you clone the repo on this machine (a dedicated clone, NOT the
  GitHub Actions runner's working directory -- see run_daemon.sh's header
  comment for why). See the setup instructions for install steps.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dineshtbits.sabarimala-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/CHANGEME/sabarimala-daemon/run_daemon.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/CHANGEME/sabarimala-daemon</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Minimum seconds between restarts, so a persistently broken state
         doesn't spin the CPU in a tight crash loop. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/CHANGEME/sabarimala-daemon/logs/daemon_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/CHANGEME/sabarimala-daemon/logs/daemon_stderr.log</string>
</dict>
</plist>
