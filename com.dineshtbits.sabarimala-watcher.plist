<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd LaunchAgent: keeps monitors/run_watcher.sh running. The watcher
  itself checks every 10 minutes and exits when new code lands on main,
  and KeepAlive relaunches it (run_watcher.sh pulls first).

  BEFORE installing, replace /Users/CHANGEME with your home directory and
  clone path, e.g. /Users/dinesh/sabarimala-watcher. See README.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dineshtbits.sabarimala-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/CHANGEME/sabarimala-watcher/monitors/run_watcher.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/CHANGEME/sabarimala-watcher</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Minimum seconds between relaunches, so a crash loop can't spin the CPU. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/CHANGEME/sabarimala-watcher/logs/watcher_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/CHANGEME/sabarimala-watcher/logs/watcher_stderr.log</string>
</dict>
</plist>
